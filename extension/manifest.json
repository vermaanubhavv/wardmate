{
  "manifest_version": 3,
  "name": "WardMate — prescription fill",
  "version": "0.1.0",
  "description": "Fills the hospital prescribing form from a discharge summary prepared in WardMate. Never saves or submits.",
  "permissions": ["storage"],
  "host_permissions": ["https://gateway.esic.gov.in/*"],
  "content_scripts": [
    {
      "matches": [
        "https://gateway.esic.gov.in/Hospital/ClinicalRecords/ClientSide_Prescriptions.aspx*",
        "https://gateway.esic.gov.in/Hospital/ClinicalRecords/FUP.aspx*"
      ],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle"
    }
  ]
}
