# `npm run deploy:init` copies this to env/production.env for you (git-ignored).
#
# Put here ONLY the variables you want to control from code — the ones you'd otherwise
# change in the Vercel dashboard. `npm run env:sync` (and `npm run ship`) push every line
# below to Vercel (Production + Preview); unchanged values are skipped.
#
# Do NOT copy your API keys / Supabase secrets here — they already live in Vercel and are
# left alone. A blank value below is ignored, not pushed as empty.

# Turns Sentry on in production once it has a real value (paste the DSN here).
NEXT_PUBLIC_SENTRY_DSN=

# Uncomment and set only what you actually want to manage from code. Anything left
# commented or blank is not touched in Vercel.
# STT_PROVIDER=deepgram
# NEXT_PUBLIC_LIVE_DICTATION=1
# SPECIALTY_PACKS=1
# NEXT_PUBLIC_SCORING_ENGINE=1
